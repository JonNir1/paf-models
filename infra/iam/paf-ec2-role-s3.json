{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPafPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::jon-nir",
      "Condition": { "StringLike": { "s3:prefix": ["paf-models", "paf-models/*"] } }
    },
    {
      "Sid": "ReadWritePafPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::jon-nir/paf-models/*"
    },
    {
      "Sid": "NoDeletes",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::jon-nir/*"
    }
  ]
}
